# Entorno virtual de Python
.venv/
__pycache__/
*.pyc

# Config local del cliente MCP (específica de esta máquina). La skill de
# generar-post sí va en git: .claude/skills/ es donde Claude Code la busca.
.claude/*
!.claude/skills/

# Exportaciones de posts (imágenes regenerables, no son código fuente)
posts/

# Historial de publicaciones: estado mutable local, no código. Cambia en cada
# post (ruido de commits) y contiene links de edición de Canva.
historial.json

# Token de Pollinations.ai: credencial local, jamás en git
.pollinations_token

# Publicación automática: config con tokens de Instagram/TikTok, la cola de
# posts pendientes y los ya publicados. Credenciales y contenido, no código.
publicacion_config.json
cola/
publicados/
publicador.log
generacion.log

# macOS
.DS_Store
